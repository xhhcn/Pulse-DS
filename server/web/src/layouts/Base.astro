---
/**
 * Shared document shell: meta, pre-paint theme/language bootstrap, the
 * synchronous navbar-config load (localized tab title, favicon, glass mode,
 * operator custom CSS/JS) and the global stylesheet.
 */
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Page key for the localized tab title prefix ("admin" → "Admin" / "管理"). */
  page?: 'admin' | 'login';
}
const { title, description = 'Pulse-DS — real-time server and hardware monitoring.', page = '' } = Astro.props;
const apiBase = import.meta.env.PUBLIC_API_BASE ?? '';
---

<html lang="en" class="dark" data-api-base={apiBase} data-page={page}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="color-scheme" content="dark light" />
    <!-- Set below to the top bar's colour for the theme in use; theme.ts keeps it in step. -->
    <meta name="theme-color" content="#18191b" />
    <!-- The .ico (16/32/48 px) serves browsers without SVG favicons; home screens need raster icons. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <title>{title}</title>
    <script is:inline>
      (function () {
        var html = document.documentElement;
        var lang = null;
        try { lang = localStorage.getItem('preferred-language'); } catch (e) {}
        if (lang !== 'zh' && lang !== 'en') {
          var sys = (navigator.language || 'en').toLowerCase();
          lang = sys.indexOf('zh') === 0 ? 'zh' : 'en';
        }
        html.lang = lang === 'zh' ? 'zh-CN' : 'en';
        // The pages are built with English text. In Chinese, keep that text
        // hidden (its space kept) until the page script has put in the
        // translation, rather than show one language and then the other; it
        // shows regardless after 1.5 s.
        if (lang === 'zh') {
          html.classList.add('i18n-pending');
          setTimeout(function () { html.classList.remove('i18n-pending'); }, 1500);
        }
        var theme = null;
        try { theme = localStorage.getItem('preferred-theme'); } catch (e) {}
        if (theme !== 'dark' && theme !== 'light') {
          theme = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        html.classList.remove('dark', 'light');
        html.classList.add(theme);
        var applyBody = function () {
          if (document.body) { document.body.classList.remove('dark', 'light'); document.body.classList.add(theme); }
          else requestAnimationFrame(applyBody);
        };
        applyBody();

        // Navbar config: loaded synchronously so operator custom CSS / JS is
        // in place before first paint and before DOMContentLoaded.
        var glass = false;
        var site = 'Pulse-DS';
        try {
          var xhr = new XMLHttpRequest();
          xhr.open('GET', '/api/navbar/config', false);
          xhr.send();
          if (xhr.status === 200) {
            var cfg = JSON.parse(xhr.responseText);
            window.__navbarConfig = cfg;
            site = (cfg.text && String(cfg.text).trim()) || site;
            if (cfg.logo && /^(https?:\/\/|\/|data:image)/i.test(String(cfg.logo).trim())) {
              // The operator's logo replaces every tab icon, so the browser
              // cannot fall back to the default .ico or .svg.
              var logo = String(cfg.logo).trim();
              var ext = logo.toLowerCase().split('?')[0].split('.').pop();
              var types = { svg: 'image/svg+xml', png: 'image/png', jpg: 'image/jpeg', jpeg: 'image/jpeg', ico: 'image/x-icon' };
              var icons = document.querySelectorAll('link[rel="icon"]');
              for (var i = icons.length - 1; i >= 0; i--) {
                if (i > 0) { icons[i].parentNode.removeChild(icons[i]); continue; }
                icons[i].href = logo;
                icons[i].removeAttribute('sizes');
                if (types[ext]) icons[i].type = types[ext]; else icons[i].removeAttribute('type');
              }
              // Home screens only take raster images: a PNG or JPEG logo can stand in.
              if (/^data:image\/(png|jpeg)/i.test(logo) || /\.(png|jpe?g)$/i.test(logo.split('?')[0])) {
                var touch = document.querySelector('link[rel="apple-touch-icon"]');
                if (touch) touch.href = logo;
              }
            }
            if (cfg.show_glass) html.classList.add('glass-enabled');
            glass = !!cfg.show_glass;
            if (cfg.custom_css && String(cfg.custom_css).trim()) {
              var st = document.createElement('style');
              st.setAttribute('data-custom-css', '');
              st.textContent = cfg.custom_css;
              document.head.appendChild(st);
            }
            if (cfg.custom_js && String(cfg.custom_js).trim()) {
              // Served by this origin as plain JavaScript (the server strips
              // legacy <script> wrappers), so it passes the content security
              // policy; inline injection would not.
              var s = document.createElement('script');
              s.src = '/api/custom/script.js';
              s.async = false;
              document.head.appendChild(s);
            }
          }
        } catch (e) {}

        // Tab title in the page's language: "管理 · Pulse-DS" / "Admin · Pulse-DS".
        // nav.ts keeps it in step when the language is switched.
        var pages = { admin: ['Admin', '管理'], login: ['Login', '登录'] };
        var pageName = pages[html.getAttribute('data-page') || ''];
        document.title = pageName ? pageName[lang === 'zh' ? 1 : 0] + ' · ' + site : site;

        // Browser chrome (the iPhone status bar, Safari's tinted tab bar)
        // takes the top bar's colour for the theme chosen here, not the OS's.
        var tc = document.querySelector('meta[name="theme-color"]');
        if (tc) tc.setAttribute('content', theme === 'dark' ? (glass ? '#12121a' : '#18191b') : glass ? '#fcfcfe' : '#ffffff');
      })();
    </script>
  </head>
  <body class="min-h-screen">
    <slot />
  </body>
</html>
