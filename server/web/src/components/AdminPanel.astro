---
import Icon from './Icon.astro';

// Placeholder for the custom-code textarea, assembled without literal
// tag pairs so the dev-server script scanner does not trip on them.
const lt = '<';
const customCodePlaceholder = [
  lt + 'style>',
  '#all-systems-title { letter-spacing: 0.02em; }',
  lt + '/style>',
  '',
  lt + 'script>',
  "console.log('custom code loaded');",
  lt + '/script>',
].join('\n');
---

<section class="mx-auto max-w-7xl page-x pt-5 sm:pt-7 pb-2">
  <div class="card">
    <div class="admin-top">
      <div class="admin-heading">
        <h1 class="text-[16px] font-semibold" data-i18n="admin.title">Admin console</h1>
        <!-- A non-breaking space holds the line until the count arrives, so the list does not move down. -->
        <p id="admin-subtitle" class="text-[12px] t-3 mt-0.5">&nbsp;</p>
      </div>
      <div class="admin-actions">
        <button id="add-btn" type="button" class="btn btn-primary"><Icon name="plus" size={15} /><span data-i18n="admin.add">Add server</span></button>
        <button id="settings-btn" type="button" class="btn"><Icon name="sliders" size={15} /><span data-i18n="admin.settings">Settings</span></button>
      </div>
      <div class="admin-tools">
        <button id="refresh-btn" type="button" class="icon-btn" data-i18n-title="common.refresh"><Icon name="refresh" size={16} /></button>
        <button id="backup-btn" type="button" class="icon-btn" data-i18n-title="admin.backup"><Icon name="download" size={16} /></button>
        <button id="password-btn" type="button" class="icon-btn" data-i18n-title="admin.changePassword"><Icon name="lock" size={16} /></button>
        <button id="logout-btn" type="button" class="icon-btn" data-i18n-title="admin.logout"><Icon name="log-out" size={16} /></button>
      </div>
    </div>
    <div id="admin-table" class="admin-table is-empty">
      <div class="admin-head" aria-hidden="true">
        <div class="h-grip"></div>
        <div class="h-main" data-i18n="admin.col.server">Server</div>
        <div class="h-sys" data-i18n="admin.col.system">System</div>
        <div class="h-net" data-i18n="admin.col.address">Address</div>
        <div class="h-traffic" data-i18n="admin.col.traffic">Total traffic</div>
        <div class="h-actions"></div>
      </div>
      <div id="admin-list" role="list">
        <div class="py-12 text-center text-[13px] t-3" data-i18n="admin.loading">Loading…</div>
      </div>
    </div>
  </div>
</section>

<!-- Install the agent: both commands in full, copied with one click. -->
<div id="install-modal" class="modal-root" hidden>
  <div class="modal-backdrop"></div>
  <div class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="install-title">
    <div class="modal-head">
      <div class="min-w-0"><div id="install-title" class="modal-title" data-i18n="admin.install.title">Install the agent</div><div id="install-sub" class="modal-sub"></div></div>
      <button type="button" class="icon-btn -mr-1.5 -mt-1" data-modal-close data-i18n-title="common.close"><Icon name="x" size={18} /></button>
    </div>
    <div class="modal-body flex flex-col gap-4">
      <p class="text-[13px] t-2" data-i18n="admin.install.desc">Run the command for this server's system on the server itself.</p>
      <div class="cmd-block" data-os="linux">
        <div class="cmd-head">
          <span class="cmd-label">Linux / macOS</span>
          <button type="button" class="btn btn-sm cmd-copy" data-act="linux"><span class="i-copy"><Icon name="copy" size={13} /></span><span class="i-check" hidden><Icon name="check" size={13} /></span><span class="cmd-copy-text" data-i18n="common.copy">Copy</span></button>
        </div>
        <pre class="cmd-text" id="install-linux"></pre>
      </div>
      <div class="cmd-block" data-os="windows">
        <div class="cmd-head">
          <span class="cmd-label">Windows<span class="t-3 font-normal" data-i18n="admin.install.windowsNote"> (PowerShell as administrator)</span></span>
          <button type="button" class="btn btn-sm cmd-copy" data-act="windows"><span class="i-copy"><Icon name="copy" size={13} /></span><span class="i-check" hidden><Icon name="check" size={13} /></span><span class="cmd-copy-text" data-i18n="common.copy">Copy</span></button>
        </div>
        <pre class="cmd-text" id="install-windows"></pre>
      </div>
      <p id="install-secret" class="field-hint flex items-start gap-2 !mt-0"><Icon name="key" size={13} class="shrink-0 mt-0.5" /><span data-i18n="admin.install.secretNote"></span></p>
      <p id="install-nosecret" class="field-hint text-[var(--warn)] flex items-start gap-2 !mt-0" hidden><Icon name="alert-triangle" size={13} class="shrink-0 mt-0.5" /><span data-i18n="admin.install.noSecret"></span></p>
      <p id="install-error" class="field-error" role="alert" hidden></p>
    </div>
    <div class="modal-foot">
      <button type="button" class="btn" data-modal-close data-i18n="common.done">Done</button>
    </div>
  </div>
</div>

<!-- Add -->
<div id="add-modal" class="modal-root" hidden>
  <div class="modal-backdrop"></div>
  <div class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="add-title" aria-describedby="add-desc">
    <form id="add-form" class="modal-form" novalidate>
      <div class="modal-head">
        <div><div id="add-title" class="modal-title" data-i18n="admin.addModal.title">Add server</div><div id="add-desc" class="modal-sub" data-i18n="admin.addModal.desc"></div></div>
        <button type="button" class="icon-btn -mr-1.5 -mt-1" data-modal-close data-i18n-title="common.close"><Icon name="x" size={18} /></button>
      </div>
      <div class="modal-body flex flex-col gap-4">
        <div>
          <label class="field-label" for="add-name"><span data-i18n="admin.form.name">Display name</span> <span class="text-[var(--crit)]">*</span></label>
          <input id="add-name" name="name" class="input" required autocomplete="off" aria-describedby="add-name-error" data-i18n-placeholder="admin.form.namePlaceholder" data-autofocus />
          <p id="add-name-error" class="field-error mt-1.5" hidden></p>
        </div>
        <p class="field-hint flex items-start gap-2"><Icon name="info" size={13} class="shrink-0 mt-0.5" /><span data-i18n="admin.form.note"></span></p>
        <p id="add-error" class="field-error" hidden></p>
      </div>
      <div class="modal-foot">
        <button type="button" class="btn" data-modal-close data-i18n="common.cancel">Cancel</button>
        <button type="submit" class="btn btn-primary" data-i18n="admin.form.add">Add</button>
      </div>
    </form>
  </div>
</div>

<!-- Edit -->
<div id="edit-modal" class="modal-root" hidden>
  <div class="modal-backdrop"></div>
  <div class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="edit-title">
    <form id="edit-form" class="modal-form" novalidate>
      <input type="hidden" name="id" />
      <div class="modal-head">
        <div><div id="edit-title" class="modal-title" data-i18n="admin.editModal.title">Edit server</div><div class="modal-sub mono" id="edit-id-label"></div></div>
        <button type="button" class="icon-btn -mr-1.5 -mt-1" data-modal-close data-i18n-title="common.close"><Icon name="x" size={18} /></button>
      </div>
      <div class="modal-body flex flex-col gap-4">
        <div>
          <label class="field-label" for="edit-name"><span data-i18n="admin.form.name">Display name</span> <span class="text-[var(--crit)]">*</span></label>
          <input id="edit-name" name="name" class="input" required autocomplete="off" aria-describedby="edit-name-error" data-autofocus />
          <p id="edit-name-error" class="field-error mt-1.5" hidden></p>
        </div>
        <div>
          <label class="field-label" for="edit-tags" data-i18n="admin.form.tags">Tags</label>
          <input id="edit-tags" name="tags" class="input" autocomplete="off" placeholder="Python, traffic:in, speed:out, spr:VIP, spb:pro" />
          <p class="field-hint" data-i18n="admin.form.tagsHint"></p>
        </div>
        <div>
          <div class="setting-row">
            <div><div id="edit-home-label" class="setting-title" data-i18n="admin.form.showOnHome">Show on homepage</div><div id="edit-home-desc" class="setting-desc" data-i18n="admin.form.showOnHomeDesc"></div></div>
            <label class="switch"><input type="checkbox" name="show_on_home" aria-labelledby="edit-home-label" aria-describedby="edit-home-desc" checked /><span></span></label>
          </div>
          <div class="setting-row">
            <div><div id="edit-tcping-label" class="setting-title" data-i18n="admin.form.showTcping">Show TCPing</div><div id="edit-tcping-desc" class="setting-desc" data-i18n="admin.form.showTcpingDesc"></div></div>
            <label class="switch"><input type="checkbox" name="show_tcping" aria-labelledby="edit-tcping-label" aria-describedby="edit-tcping-desc" checked /><span></span></label>
          </div>
        </div>
        <p class="field-hint flex items-start gap-2"><Icon name="info" size={13} class="shrink-0 mt-0.5" /><span data-i18n="admin.form.note"></span></p>
        <p id="edit-error" class="field-error" hidden></p>
      </div>
      <div class="modal-foot">
        <button type="button" class="btn" data-modal-close data-i18n="common.cancel">Cancel</button>
        <button type="submit" class="btn btn-primary" data-i18n="admin.form.update">Save changes</button>
      </div>
    </form>
  </div>
</div>

<!-- Delete -->
<div id="delete-modal" class="modal-root" hidden>
  <div class="modal-backdrop"></div>
  <div class="modal-panel" role="alertdialog" aria-modal="true" aria-labelledby="delete-title" aria-describedby="delete-text">
    <div class="modal-head sm:items-center">
      <div class="flex items-center gap-3">
        <span class="icon-tile is-crit"><Icon name="trash" size={17} /></span>
        <div id="delete-title" class="modal-title" data-i18n="admin.deleteModal.title">Delete server</div>
      </div>
      <button type="button" class="icon-btn -mr-1.5 -mt-1 sm:mt-0" data-modal-close data-i18n-title="common.close"><Icon name="x" size={18} /></button>
    </div>
    <div class="modal-body text-[13px] t-2" id="delete-text"></div>
    <div class="modal-foot">
      <button type="button" class="btn" data-modal-close data-i18n="common.cancel">Cancel</button>
      <button type="button" id="delete-confirm" class="btn btn-danger" data-i18n="common.delete">Delete</button>
    </div>
  </div>
</div>

<!-- Settings -->
<div id="settings-modal" class="modal-root" hidden>
  <div class="modal-backdrop"></div>
  <div class="modal-panel is-wide" role="dialog" aria-modal="true" aria-labelledby="settings-title">
    <div class="modal-head">
      <div id="settings-title" class="modal-title" data-i18n="settings.title">Settings</div>
      <button type="button" class="icon-btn -mr-1.5 -mt-1" data-modal-close data-i18n-title="common.close"><Icon name="x" size={18} /></button>
    </div>
    <div class="px-4 sm:px-5 pt-3 shrink-0">
      <div class="tabs" role="tablist" id="settings-tabs">
        <button type="button" class="tab" role="tab" data-stab="general" aria-selected="true"><Icon name="sliders" size={13} /><span data-i18n="settings.tab.general">General</span></button>
        <button type="button" class="tab" role="tab" data-stab="display" aria-selected="false"><Icon name="palette" size={13} /><span data-i18n="settings.tab.display">Display</span></button>
        <button type="button" class="tab" role="tab" data-stab="privacy" aria-selected="false"><Icon name="shield" size={13} /><span data-i18n="settings.tab.privacy">Privacy</span></button>
        <button type="button" class="tab" role="tab" data-stab="tcping" aria-selected="false"><Icon name="radio" size={13} /><span data-i18n="settings.tab.tcping">TCPing</span></button>
      </div>
    </div>
    <div class="modal-body">
      <!-- General -->
      <div data-spanel="general" class="flex flex-col gap-4">
        <div>
          <label class="field-label" for="s-text" data-i18n="settings.navbarText">Site name</label>
          <input id="s-text" class="input" placeholder="Pulse-DS" />
          <p class="field-hint" data-i18n="settings.navbarTextHint"></p>
        </div>
        <div>
          <label class="field-label" for="s-logo" data-i18n="settings.navbarLogo">Logo</label>
          <input id="s-logo" class="input" placeholder="https://example.com/logo.svg" />
          <p class="field-hint" data-i18n="settings.navbarLogoHint"></p>
        </div>
        <div>
          <label class="field-label" for="s-secret" data-i18n="settings.sharedSecret">Shared secret</label>
          <div class="flex gap-2">
            <input id="s-secret" class="input mono flex-1" readonly />
            <button type="button" id="s-secret-copy" class="btn" data-i18n-title="common.copy"><span class="i-copy"><Icon name="copy" size={14} /></span><span class="i-check text-[var(--ok)]" hidden><Icon name="check" size={14} /></span></button>
            <button type="button" id="s-secret-regen" class="btn btn-warn"><Icon name="key" size={14} /><span data-i18n="settings.regenerate">Regenerate</span></button>
          </div>
          <p class="field-hint" data-i18n="settings.sharedSecretHint"></p>
          <p id="s-secret-note" class="field-hint text-[var(--warn)]" hidden></p>
        </div>
      </div>
      <!-- Display -->
      <div data-spanel="display" class="flex flex-col gap-4" hidden>
        <div>
          <div class="setting-row">
            <div><div id="s-show-cards-label" class="setting-title" data-i18n="settings.showCards"></div><div id="s-show-cards-desc" class="setting-desc" data-i18n="settings.showCardsDesc"></div></div>
            <label class="switch"><input type="checkbox" id="s-show-cards" aria-labelledby="s-show-cards-label" aria-describedby="s-show-cards-desc" /><span></span></label>
          </div>
          <div class="setting-row">
            <div><div id="s-show-tags-label" class="setting-title" data-i18n="settings.showTags"></div><div id="s-show-tags-desc" class="setting-desc" data-i18n="settings.showTagsDesc"></div></div>
            <label class="switch"><input type="checkbox" id="s-show-tags" aria-labelledby="s-show-tags-label" aria-describedby="s-show-tags-desc" /><span></span></label>
          </div>
          <div class="setting-row">
            <div><div id="s-show-traffic-label" class="setting-title" data-i18n="settings.showTraffic"></div><div id="s-show-traffic-desc" class="setting-desc" data-i18n="settings.showTrafficDesc"></div></div>
            <label class="switch"><input type="checkbox" id="s-show-traffic" aria-labelledby="s-show-traffic-label" aria-describedby="s-show-traffic-desc" /><span></span></label>
          </div>
          <div class="setting-row">
            <div><div id="s-glass-label" class="setting-title" data-i18n="settings.glass"></div><div id="s-glass-desc" class="setting-desc" data-i18n="settings.glassDesc"></div></div>
            <label class="switch"><input type="checkbox" id="s-glass" aria-labelledby="s-glass-label" aria-describedby="s-glass-desc" /><span></span></label>
          </div>
        </div>
        <div>
          <label class="field-label" for="s-code" data-i18n="settings.customCode">Custom CSS &amp; JavaScript</label>
          <textarea id="s-code" class="textarea" rows="9" placeholder={customCodePlaceholder}></textarea>
          <p class="field-hint" data-i18n="settings.customCodeHint"></p>
          <p class="field-hint text-[var(--warn)] flex items-start gap-1.5"><Icon name="alert-triangle" size={12} class="shrink-0 mt-0.5" /><span data-i18n="settings.customCodeWarn"></span></p>
        </div>
      </div>
      <!-- Privacy -->
      <div data-spanel="privacy" class="flex flex-col gap-4" hidden>
        <div class="setting-row">
          <div><div id="s-privacy-label" class="setting-title" data-i18n="privacy.enable"></div><div id="s-privacy-desc" class="setting-desc" data-i18n="privacy.enableDesc"></div></div>
          <label class="switch"><input type="checkbox" id="s-privacy" aria-labelledby="s-privacy-label" aria-describedby="s-privacy-desc" /><span></span></label>
        </div>
        <div class="subcard p-4 flex flex-col gap-3">
          <div>
            <div class="setting-title" data-i18n="privacy.share"></div>
            <div class="setting-desc" data-i18n="privacy.shareDesc"></div>
            <div id="s-share-off" class="setting-desc" data-i18n="privacy.shareNeedsPrivacy" hidden></div>
          </div>
          <div id="s-share" class="flex flex-col gap-3 min-w-0">
            <div id="s-share-current" hidden>
              <label class="field-label" for="s-share-link" data-i18n="privacy.current">Current link</label>
              <div class="flex gap-2">
                <input id="s-share-link" class="input mono flex-1 text-[12px]" readonly />
                <button type="button" id="s-share-copy" class="btn"><span class="i-copy"><Icon name="copy" size={14} /></span><span class="i-check text-[var(--ok)]" hidden><Icon name="check" size={14} /></span><span data-i18n="common.copy">Copy</span></button>
              </div>
              <p id="s-share-expires" class="field-hint"></p>
            </div>
            <div class="flex flex-col sm:flex-row sm:items-end gap-2">
              <fieldset id="s-share-new" class="flex flex-col sm:flex-row sm:items-end gap-2 min-w-0 sm:flex-1">
                <div class="flex-1 min-w-0">
                  <label class="field-label" for="s-share-hours" data-i18n="privacy.hours">Valid for (1–720 hours)</label>
                  <input id="s-share-hours" type="number" min="1" max="720" value="24" class="input" />
                </div>
                <button type="button" id="s-share-generate" class="btn btn-primary"><Icon name="key" size={14} /><span data-i18n="privacy.generate">Generate link</span></button>
              </fieldset>
              <button type="button" id="s-share-revoke" class="btn" hidden><span data-i18n="privacy.revoke">Revoke link</span></button>
            </div>
          </div>
        </div>
      </div>
      <!-- TCPing -->
      <div data-spanel="tcping" class="flex flex-col gap-4" hidden>
        <div>
          <label class="field-label" for="s-tcp-interval" data-i18n="tcping.interval">Polling interval</label>
          <div class="flex items-center gap-2">
            <input id="s-tcp-interval" type="number" min="1" class="input w-32" />
            <span class="text-[12px] t-3" data-i18n="common.seconds">seconds</span>
          </div>
          <p class="field-hint" data-i18n="tcping.intervalHint"></p>
        </div>
        <div>
          <label class="field-label" data-i18n="tcping.targets">Targets</label>
          <div id="s-tcp-targets" class="flex flex-col gap-2"></div>
          <button type="button" id="s-tcp-add" class="btn btn-sm mt-2"><Icon name="plus" size={13} /><span data-i18n="tcping.addTarget">Add target</span></button>
          <p class="field-hint" data-i18n="tcping.targetsHint"></p>
        </div>
      </div>
      <p id="settings-error" class="field-error mt-3" hidden></p>
    </div>
    <div class="modal-foot">
      <button type="button" class="btn" data-modal-close data-i18n="common.cancel">Cancel</button>
      <button type="button" id="settings-save" class="btn btn-primary" data-i18n="common.save">Save</button>
    </div>
  </div>
</div>

<!-- Regenerate secret confirm -->
<div id="regen-modal" class="modal-root" hidden>
  <div class="modal-backdrop"></div>
  <div class="modal-panel" role="alertdialog" aria-modal="true" aria-labelledby="regen-title" aria-describedby="regen-desc">
    <div class="modal-head sm:items-center">
      <div class="flex items-center gap-3">
        <span class="icon-tile is-warn"><Icon name="alert-triangle" size={17} /></span>
        <div id="regen-title" class="modal-title" data-i18n="settings.regenerateTitle"></div>
      </div>
      <button type="button" class="icon-btn -mr-1.5 -mt-1 sm:mt-0" data-modal-close data-i18n-title="common.close"><Icon name="x" size={18} /></button>
    </div>
    <div id="regen-desc" class="modal-body text-[13px] t-2" data-i18n="settings.regenerateDesc"></div>
    <div class="modal-foot">
      <button type="button" class="btn" data-modal-close data-i18n="common.cancel">Cancel</button>
      <button type="button" id="regen-confirm" class="btn btn-warn" data-i18n="settings.regenerate">Regenerate</button>
    </div>
  </div>
</div>

<!-- Change password -->
<div id="password-modal" class="modal-root" hidden>
  <div class="modal-backdrop"></div>
  <div class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="password-title">
    <form id="password-form" class="modal-form" novalidate>
      <div class="modal-head">
        <div id="password-title" class="modal-title" data-i18n="password.title">Change password</div>
        <button type="button" class="icon-btn -mr-1.5 -mt-1" data-modal-close data-i18n-title="common.close"><Icon name="x" size={18} /></button>
      </div>
      <div class="modal-body flex flex-col gap-4">
        <div>
          <label class="field-label" for="pw-current" data-i18n="password.current"></label>
          <input id="pw-current" name="current" type="password" class="input" autocomplete="current-password" required data-autofocus />
        </div>
        <div>
          <label class="field-label" for="pw-new" data-i18n="password.new"></label>
          <input id="pw-new" name="new" type="password" class="input" autocomplete="new-password" required aria-describedby="pw-new-hint" />
          <p id="pw-new-hint" class="field-hint" data-i18n="password.minLength"></p>
        </div>
        <div>
          <label class="field-label" for="pw-confirm" data-i18n="password.confirm"></label>
          <input id="pw-confirm" name="confirm" type="password" class="input" autocomplete="new-password" required />
        </div>
        <p id="password-error" class="field-error" hidden></p>
      </div>
      <div class="modal-foot">
        <button type="button" class="btn" data-modal-close data-i18n="common.cancel">Cancel</button>
        <button type="submit" class="btn btn-primary" data-i18n="password.submit">Change password</button>
      </div>
    </form>
  </div>
</div>

<script>
  import '../scripts/admin/main';
</script>
