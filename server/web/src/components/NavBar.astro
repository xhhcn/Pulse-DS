---
import Icon from './Icon.astro';
interface Props {
  page?: 'home' | 'admin';
  showLive?: boolean;
}
const { page = 'home', showLive = false } = Astro.props;
---

<header class="topbar">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 h-14 flex items-center justify-between gap-3">
    <a href="/" class="flex items-center gap-2.5 min-w-0" id="brand-link">
      <span id="brand-logo" class="inline-flex w-7 h-7 items-center justify-center rounded-lg text-[var(--text)] shrink-0" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" class="default-logo">
          <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M6.5 12h2l2-6 3 18 2.5-12h2">
            <animate attributeName="opacity" values="0.55;1;0.55" dur="2.4s" repeatCount="indefinite" />
          </path>
          <path stroke="currentColor" stroke-linecap="round" stroke-width="1.8" d="M2.5 12h2M19.5 12h2" opacity="0.5" />
        </svg>
      </span>
      <span id="brand-text" class="brand-name truncate">Pulse</span>
    </a>
    <div class="flex items-center gap-1.5 sm:gap-2">
      {showLive && (
        <span id="live-indicator" class="live" data-state="connecting" title="">
          <span class="dot"></span>
          <span id="live-text" data-i18n="live.reconnecting">Connecting</span>
        </span>
      )}
      <button id="lang-btn" class="icon-btn" type="button" data-i18n-title="common.language" title="Language">
        <Icon name="languages" size={17} />
      </button>
      <button id="theme-btn" class="icon-btn" type="button" title="Theme">
        <span class="only-dark"><Icon name="moon" size={17} /></span>
        <span class="only-light"><Icon name="sun" size={17} /></span>
      </button>
      {page === 'admin' ? (
        <a href="/" class="icon-btn" data-i18n-title="common.home" title="Home"><Icon name="home" size={17} /></a>
      ) : (
        <a href="/admin" class="icon-btn" data-i18n-title="common.admin" title="Admin"><Icon name="user" size={17} /></a>
      )}
    </div>
  </div>
</header>

<style is:global>
  html.dark .only-light { display: none; }
  html.light .only-dark { display: none; }
  .only-dark, .only-light { display: inline-flex; }
</style>

<script>
  import { initNav } from '../scripts/core/nav';
  initNav();
</script>
